.idea/
.DS_Store
Thumbs.db

# Claude Code - settings, skills, notes (a work tool, not part of the app)
.claude/
CLAUDE.local.md
# Every .md file except README - notes, plans, CLAUDE.md stay only on the disk
*.md
!/README.md

