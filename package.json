{
  "name": "kalkulator-uop-b2b",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Kalkulator UoP i B2B - compares a Polish employment contract with a B2B contract",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "tsc && vite build",
    "build:demo": "tsc && vite build --mode demo --outDir dist-demo && node scripts/check-demo.mjs",
    "demo:strona": "npm run build:demo && node scripts/demo-na-strone.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:look": "node scripts/look-check.mjs",
    "instrukcja": "node scripts/instrukcja-zrzuty.mjs",
    "coverage": "vitest run --coverage",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tauri-apps/api": "^2",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "playwright-core": "^1.65.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.1.0"
  }
}
